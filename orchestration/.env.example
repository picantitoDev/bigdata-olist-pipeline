# Kestra Admin Credentials
KESTRA_ADMIN_USER=your-email@example.com
KESTRA_ADMIN_PASSWORD=your-secure-password

# Google Cloud Configuration
KESTRA_GCP_PROJECT_ID=your-gcp-project-id
KESTRA_GCP_LOCATION=your-gcp-region
KESTRA_GCP_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com

# GCS Buckets
KESTRA_GCS_RAW_BUCKET=your-raw-bucket
KESTRA_GCS_PROCESSED_BUCKET=your-processed-bucket
KESTRA_GCS_SCRIPTS_BUCKET=your-scripts-bucket

# BigQuery Datasets
KESTRA_GCP_DATASET_RAW=your_raw_dataset
KESTRA_GCP_DATASET_STAGING=your_staging_dataset
KESTRA_GCP_DATASET_INTERMEDIATE=your_intermediate_dataset
KESTRA_GCP_DATASET_MARTS=your_marts_dataset

# Dataproc Cluster
KESTRA_DATAPROC_CLUSTER=your-dataproc-cluster
KESTRA_DATAPROC_REGION=your-dataproc-region